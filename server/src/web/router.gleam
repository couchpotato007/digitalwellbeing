import api/handlers
import api/router as api_router
import context
import gleam/bytes_tree
import gleam/dict.{type Dict}
import gleam/http
import gleam/http/request
import gleam/http/response
import gleam/list
import gleam/option
import gleam/string
import web/docs
import wisp

fn middleware(req, handler) {
  use <- wisp.log_request(req)
  use <- wisp.rescue_crashes
  use req <- wisp.handle_head(req)
  use req <- wisp.csrf_known_header_protection(req)
  handler(req)
}

pub fn handle_request(
  req: request.Request(wisp.Connection),
  ctx: context.Context,
) -> response.Response(wisp.Body) {
  use req <- middleware(req)
  case wisp.path_segments(req) {
    ["api", "docs"] -> docs.page()
    ["api", "openapi.yaml"] -> docs.spec()
    ["api", ..path] -> api(req, ctx, path)
    _ -> wisp.not_found()
  }
}

/// Hands the request to the router generated by oaspec from
/// `priv/openapi.yaml`. Paths in the spec are relative to `/api`.
fn api(
  req: wisp.Request,
  ctx: context.Context,
  path: List(String),
) -> wisp.Response {
  use body <- wisp.require_string_body(req)
  let method = req.method |> http.method_to_string |> string.uppercase
  let res =
    api_router.route(
      handlers.State(db: ctx.db),
      method,
      path,
      group_query(wisp.get_query(req)),
      dict.from_list(req.headers),
      body,
    )

  let wisp_body = case res.body {
    api_router.TextBody(text) -> wisp.Text(text)
    api_router.BytesBody(bytes) -> wisp.Bytes(bytes_tree.from_bit_array(bytes))
    api_router.EmptyBody -> wisp.Text("")
  }
  list.fold(res.headers, wisp.response(res.status), fn(r, header) {
    wisp.set_header(r, header.0, header.1)
  })
  |> response.set_body(wisp_body)
}

fn group_query(query: List(#(String, String))) -> Dict(String, List(String)) {
  list.fold(list.reverse(query), dict.new(), fn(acc, pair) {
    let #(key, value) = pair
    dict.upsert(acc, key, fn(existing) {
      case existing {
        option.Some(values) -> [value, ..values]
        option.None -> [value]
      }
    })
  })
}
